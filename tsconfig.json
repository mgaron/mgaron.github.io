{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "strict": true, "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
